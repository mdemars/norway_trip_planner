{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flask",
            "type": "python",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "app.py",
                "FLASK_ENV": "development"
            },
            "args": [
                "run",
                "--host=0.0.0.0",
                "--port=8080"
            ],
            "jinja": true,
            "justMyCode": true
        },
        {
            "name": "MCP Server (stdio)",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/venv/Scripts/python.exe",
            "program": "${workspaceFolder}/mcp_server.py",
            "env": {
                "TRANSPORT": "stdio"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "MCP Server (SSE / HTTP)",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/venv/Scripts/python.exe",
            "program": "${workspaceFolder}/mcp_server.py",
            "env": {
                "TRANSPORT": "sse",
                "MCP_PORT": "8090"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Load Trip",
            "type": "debugpy",
            "request": "launch",
            "program": "trip_io.py",
            "args": [
                "load",
                "1"
            ],
            "console": "integratedTerminal"
        }
    ]
}